# Generate real values with: node scripts/generate-secrets.mjs .env
# Never use these placeholders as credentials.
PSR_WEB_TOKEN=
PSR_GROKBOT_TOKEN=
PSR_DOT_TOKEN=
PSR_MUSE_TOKEN=
PSR_CLI_TOKEN=
# Optional, only when the matching daemon config references passwordEnv:
# PASEO_GPU_PASSWORD=
# Paseo relay pairing link per daemon (from `paseo pair` on that machine), referenced by pairingEnv.
# It grants owner access to that daemon: keep it secret, never commit it.
# PASEO_GPU1_PAIRING=
